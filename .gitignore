# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
public/
*.egg-info/
.env
.env.*

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.xdv

# Generated PDFs
*.pdf
!versions/
!versions/*.pdf
!versions/.gitkeep

# Keep source-controlled documentation and config explicit.
!.gitignore
!README.md

# Local-only resume variants, build leftovers and scratch work (private variants live in resume-archive)
resume-*.tex
!resume-template.tex
_temp_*
tmp/
output/
scratch/
*.png
